# ── PYTCH stack configuration (copy to .env) ──────────────────────────────

# Runtime
ENVIRONMENT=production
DEMO_MODE=true              # demo controls, dev OTP codes, bots. Set false for real deployments.
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:8080
SEED_ON_START=true          # idempotent demo data on api start

# Ports exposed on the host
WEB_PORT=8080
API_PORT=8000
DB_PORT=5433
REDIS_PORT=6380

# Database
POSTGRES_USER=pytch
POSTGRES_PASSWORD=pytch
POSTGRES_DB=pytch

# Auth — CHANGE THIS in any shared environment (32+ random bytes)
JWT_SECRET=change-me-in-production-please-32b

# Payments: mock (built-in demo checkout) | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
