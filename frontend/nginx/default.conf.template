# Rendered by the nginx image's envsubst at start-up (only ${ENV_VARS} that exist are replaced).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Access-log format without the query string (API/WS: invite codes, phone searches, a stale client's token).
log_format pytch_noquery '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# Multi-range requests (bytes=0-1,2-3,…) are dropped: they only serve range-amplification attacks.
map $http_range $pytch_single_range {
  "~^bytes=\d*-\d*$" $http_range;
  default            "";
}

upstream pytch_api {
  server api:8000;
  keepalive 32;
}

# ───────────────────────── Public: player app + partner portal ─────────────────────────
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml text/calendar;
  gzip_min_length 1024;
  client_max_body_size 5m;

  include /etc/nginx/snippets/security-public.conf;

  location = /healthz { access_log off; return 200 "ok"; }

  # The admin API is NOT reachable from the public origin — only via the admin server block.
  location ^~ /api/v1/admin { return 404; }

  location /api/ {
    access_log /var/log/nginx/access.log pytch_noquery;  # query strings carry invite codes / phone searches
    proxy_pass http://pytch_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ws {
    access_log /var/log/nginx/access.log pytch_noquery;
    proxy_pass http://pytch_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /media/ {
    proxy_pass http://pytch_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Range $pytch_single_range;  # only single ranges reach the API (video seeking)
    proxy_set_header If-Range $http_if_range;
    max_ranges 1;
    expires 7d;
    include /etc/nginx/snippets/security-public.conf;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-public.conf;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-public.conf;
    try_files $uri $uri/ /index.html;
  }
}

# ───────────────────────── Admin console (separate origin) ─────────────────────────
server {
  listen 8090;
  server_name _;
  root /usr/share/nginx/admin;
  index admin.html;
  server_tokens off;
  client_max_body_size 1m;

  # Network allowlist (defense in depth; the API enforces ADMIN_IP_ALLOWLIST too).
  allow ${ADMIN_ALLOW_CIDR};
  deny all;

  include /etc/nginx/snippets/security-admin.conf;

  location = /healthz { access_log off; return 200 "ok"; }

  # Only the admin API (and public meta) are proxied from this origin.
  location /api/v1/admin/ {
    access_log /var/log/nginx/access.log pytch_noquery;  # player searches (phones) travel in the query
    proxy_pass http://pytch_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location = /api/v1/meta { proxy_pass http://pytch_api; proxy_set_header X-Real-IP $remote_addr; }
  location /api/ { return 404; }
  location /ws { return 404; }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-admin.conf;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-store";
    include /etc/nginx/snippets/security-admin.conf;
    try_files $uri /admin.html;
  }
}
